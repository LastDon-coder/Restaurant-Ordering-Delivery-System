# Copy this file to .env and fill in your values. Never commit .env.
NODE_ENV=development
PORT=5000
# The React app's address (Vite's default). Only this origin may call the API from a browser.
CORS_ORIGIN=http://localhost:5173

# Signs login tokens. Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Base address used in password reset links (defaults to CORS_ORIGIN).
FRONTEND_URL=http://localhost:5173

# Flat delivery fee added to every order (not charged on an empty cart). 0 = free delivery.
DELIVERY_FEE=500

# Paystack (online payments). Use the SECRET key from Dashboard > Settings > API Keys & Webhooks.
# sk_test_... for testing, sk_live_... only on the production server. Required when NODE_ENV=production.
PAYSTACK_SECRET_KEY=
# Optional: where the customer's browser returns after paying (default: FRONTEND_URL + /payment/callback).
# PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
# Set the webhook URL in the Paystack dashboard to: https://YOUR-PUBLIC-URL/api/v1/payments/webhook

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db

# Used only by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Used only by `npm run seed:test-users` (development only): the password given to the test
# customer, staff and rider accounts. At least 10 characters.
TEST_USER_PASSWORD=
