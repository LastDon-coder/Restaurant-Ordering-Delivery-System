# Copy this file to .env and fill in your values. Never commit .env.
NODE_ENV=development
PORT=5000
# The React app's address (Vite's default). Only this origin may call the API from a browser.
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db

# Used only by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
