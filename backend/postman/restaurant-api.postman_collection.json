        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_name\": \"Desserts\",\n  \"description\": \"Cakes and ice cream\",\n  \"image_url\": \"https://example.com/desserts.jpg\"\n}",
          "options": {
