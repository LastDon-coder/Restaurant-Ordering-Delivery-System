            "v1",
            "auth",
            "reset-password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_64_CHARACTER_TOKEN_FROM_THE_RESET_LINK\",\n  \"password\": \"NewPassword123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login (admin) - use your ADMIN_EMAIL / ADMIN_PASSWORD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
