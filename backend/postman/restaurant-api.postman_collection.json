        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const body = pm.response.json();",
                "if (body.data && body.data.category) { pm.collectionVariables.set(\"categoryId\", body.data.category.category_id); }"
              ]
            }
          }
        ]
      },
      "event": [
        {
          "listen": "test",
