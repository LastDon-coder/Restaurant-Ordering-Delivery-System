          "raw": "{\n  \"first_name\": \"Emeka\",\n  \"last_name\": \"Rider\",\n  \"email\": \"rider@example.com\",\n  \"phone\": \"08098765432\",\n  \"password\": \"RiderPass123\",\n  \"role\": \"rider\"\n}",
          "options": {
