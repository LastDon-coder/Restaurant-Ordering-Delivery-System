# Copy to .env (never commit .env). Both values are PUBLIC by design (they ship to the browser).
# Safety comes from Row Level Security in the database, not from hiding these.
# NEVER put the Supabase secret / service_role key or the Paystack secret key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
