# Copy this file to .env.e2e (same folder) and fill in the passwords. .env.e2e is ignored by git: never commit it.
# These are four test accounts in your LIVE Supabase project. The e2e-admin account is a REAL admin: protect this file.
E2E_CUSTOMER_PASSWORD=
E2E_STAFF_PASSWORD=
E2E_RIDER_PASSWORD=
E2E_ADMIN_PASSWORD=

# Optional. Emails default to e2e-<role>@example.com. To test the deployed site instead of starting the app locally:
# E2E_BASE_URL=https://restaurant-ordering-delivery.vercel.app
